# Generated by configure for pycallocs

# Installation prefix
PREFIX := @prefix@
PYTHON := @PYTHON@

# Source and build directories
SRCDIR := @abs_srcdir@
BUILDDIR := @abs_builddir@

# Contrib directory
LIBALLOCS := @liballocs@
LIBRUNT := @librunt@
LIBSYSTRAP := @libsystrap@
LIBALLOCSTOOL := @liballocstool@

# Compiler configuration
ALLOCSCC := @allocscc@
USE_ALLOCSCC := @use_allocscc@
ifeq ($(USE_ALLOCSCC),yes)
CC := $(ALLOCSCC)
export CC
endif

# Lifetime policies (required for pycallocs)
LIFETIME_POLICIES := @lifetime_policies@
export LIFETIME_POLICIES

# Include liballocs config
include $(LIBALLOCS)/config.mk

# Export paths for Python setup.py
export LIBALLOCS
export LIBRUNT
export LIBALLOCSTOOL

.PHONY: all build install test clean
